---
// Selective WebGL: precise material field (Atlas Motion craft)
// ONE quiet moment, always-on-but-slow, not twitchy
const { children } = Astro.props;
---

<div class="editorial-hero">
  <canvas class="material-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <slot />
  </div>
</div>

<style>
  .editorial-hero {
    position: relative;
    width: 100%;
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .material-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 1;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  @media (max-width: 768px) {
    .material-canvas {
      display: none;
    }
    
    .editorial-hero {
      min-height: 60vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .material-canvas {
      display: none;
    }
  }
</style>

<script>
  async function initMaterialField() {
    // Skip on small viewports or reduced motion
    if (window.innerWidth <= 768) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const container = document.querySelector('.editorial-hero') as HTMLElement;
    const canvas = document.querySelector('.material-canvas') as HTMLCanvasElement;
    
    if (!container || !canvas) return;

    // Lazy-load Three.js
    const THREE = await import('three');

    // Setup Three.js
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const renderer = new THREE.WebGLRenderer({ 
      canvas, 
      alpha: true,
      antialias: false,
      powerPreference: 'low-power'
    });

    const rect = container.getBoundingClientRect();
    renderer.setSize(rect.width, rect.height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Precise material field - subtle depth gradient
    // ONE selective WebGL moment, always-on-but-slow
    const material = new THREE.ShaderMaterial({
      transparent: true,
      uniforms: {
        uTime: { value: 0.0 },
        uResolution: { value: new THREE.Vector2(rect.width, rect.height) }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec2 uResolution;
        varying vec2 vUv;
        
        // Precise noise for subtle material texture
        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }
        
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          f = f * f * (3.0 - 2.0 * f);
          
          float a = hash(i);
          float b = hash(i + vec2(1.0, 0.0));
          float c = hash(i + vec2(0.0, 1.0));
          float d = hash(i + vec2(1.0, 1.0));
          
          return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }
        
        void main() {
          vec2 uv = vUv;
          
          // Very slow drift (30-60s period) - precise, not glitchy
          float time = uTime * 0.02;
          
          // Subtle vertical gradient with slow drift
          float gradient = uv.y * 0.6 + 0.4;
          
          // Add minimal noise for paper-like texture
          vec2 noisePos = uv * 8.0 + vec2(time * 0.1, time * 0.05);
          float paperNoise = noise(noisePos) * 0.015;
          
          // Slow horizontal drift
          float drift = sin(uv.x * 2.0 + time * 0.3) * 0.008;
          
          // Combine: very subtle depth field
          float field = gradient + paperNoise + drift;
          
          // Warm paper base #FAFAF8
          vec3 paper = vec3(0.98, 0.98, 0.973);
          
          // Very subtle warm tint toward vermilion at top
          vec3 tint = mix(
            paper,
            vec3(0.99, 0.975, 0.97), // Slightly warmer
            field * 0.12
          );
          
          // Extremely low opacity - barely perceptible depth
          float alpha = 0.08;
          
          gl_FragColor = vec4(tint, alpha);
        }
      `
    });

    const geometry = new THREE.PlaneGeometry(2, 2);
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    // Animation state
    let animationFrame: number | null = null;
    let isDisposed = false;
    let startTime = Date.now();

    // Continuous slow drift - precise, not twitchy
    function render() {
      if (isDisposed) return;
      
      const elapsed = (Date.now() - startTime) * 0.001;
      material.uniforms.uTime.value = elapsed;
      
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(render);
    }

    // Handle window resize
    let resizeTimeout: ReturnType<typeof setTimeout>;
    
    function handleResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (window.innerWidth <= 768 && !isDisposed) {
          cleanup();
          return;
        }
        
        if (isDisposed) return;
        
        const newRect = container.getBoundingClientRect();
        renderer.setSize(newRect.width, newRect.height);
        material.uniforms.uResolution.value.set(newRect.width, newRect.height);
      }, 250);
    }

    function cleanup() {
      isDisposed = true;
      if (animationFrame) cancelAnimationFrame(animationFrame);
      
      const gl = renderer.getContext();
      if (gl && gl.getExtension('WEBGL_lose_context')) {
        gl.getExtension('WEBGL_lose_context')!.loseContext();
      }
      
      renderer.dispose();
      geometry.dispose();
      material.dispose();
    }

    // Handle tab visibility
    function handleVisibilityChange() {
      if (document.hidden && animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = null;
      } else if (!document.hidden && !animationFrame && !isDisposed) {
        render();
      }
    }

    window.addEventListener('resize', handleResize);
    window.addEventListener('visibilitychange', handleVisibilityChange);

    // Start continuous slow drift
    render();

    return cleanup;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMaterialField);
  } else {
    initMaterialField();
  }
</script>
