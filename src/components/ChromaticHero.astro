---
// Aurora/Siri-listening field behind headline
// Soft iridescent wave, delicate, always-on-but-quiet
const { children } = Astro.props;
---

<div class="chromatic-hero">
  <canvas class="aurora-canvas" aria-hidden="true"></canvas>
  <h1 class="hero-headline">
    <slot />
  </h1>
</div>

<style>
  .chromatic-hero {
    position: relative;
    width: 100%;
  }

  .aurora-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 1;
  }

  .hero-headline {
    position: relative;
    z-index: 1;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 0;
    max-width: 1000px;
  }

  @media (max-width: 768px) {
    .aurora-canvas {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-canvas {
      display: none;
    }
  }
</style>

<script>
  async function initAuroraEffect() {
    // Skip on small viewports or reduced motion
    if (window.innerWidth <= 768) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const container = document.querySelector('.chromatic-hero') as HTMLElement;
    const canvas = document.querySelector('.aurora-canvas') as HTMLCanvasElement;
    const headline = document.querySelector('.hero-headline') as HTMLHeadingElement;
    
    if (!container || !canvas || !headline) return;

    // Lazy-load Three.js
    const THREE = await import('three');

    // Wait for fonts to load
    await document.fonts.ready;

    // Capture text as a soft glow mask
    function captureTextMask(): HTMLCanvasElement {
      const textCanvas = document.createElement('canvas');
      const ctx = textCanvas.getContext('2d')!;
      
      const rect = headline.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio, 2);
      textCanvas.width = rect.width * dpr;
      textCanvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
      
      const styles = window.getComputedStyle(headline);
      ctx.font = `${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
      ctx.fillStyle = 'white';
      ctx.textBaseline = 'top';
      
      const text = headline.textContent || '';
      const lineHeightPx = parseFloat(styles.lineHeight);
      
      // Detect line breaks using Range
      const range = document.createRange();
      range.selectNodeContents(headline);
      const lines: string[] = [];
      let currentLine = '';
      let lastY = 0;
      
      for (let i = 0; i < text.length; i++) {
        const testChar = text[i];
        if (testChar === '\n') {
          if (currentLine.trim()) lines.push(currentLine.trim());
          currentLine = '';
          continue;
        }
        
        range.setStart(headline.firstChild!, 0);
        range.setEnd(headline.firstChild!, i + 1);
        const rects = range.getClientRects();
        
        if (rects.length > 0) {
          const lastRect = rects[rects.length - 1];
          const currentY = lastRect.top;
          
          if (i > 0 && currentY > lastY + 2) {
            if (currentLine.trim()) lines.push(currentLine.trim());
            currentLine = testChar;
            lastY = currentY;
          } else {
            currentLine += testChar;
            lastY = currentY;
          }
        }
      }
      
      if (currentLine.trim()) lines.push(currentLine.trim());
      
      // Render text
      let y = 0;
      for (const line of lines) {
        ctx.fillText(line, 0, y);
        y += lineHeightPx;
      }
      
      // Blur for soft glow mask
      ctx.filter = 'blur(40px)';
      ctx.globalCompositeOperation = 'destination-in';
      ctx.drawImage(textCanvas, 0, 0);
      
      return textCanvas;
    }

    const textMask = captureTextMask();
    const maskTexture = new THREE.CanvasTexture(textMask);
    maskTexture.needsUpdate = true;

    // Setup Three.js
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const renderer = new THREE.WebGLRenderer({ 
      canvas, 
      alpha: true,
      antialias: false,
      powerPreference: 'low-power'
    });

    const rect = headline.getBoundingClientRect();
    renderer.setSize(rect.width, rect.height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Aurora shader - soft iridescent wave behind text
    const material = new THREE.ShaderMaterial({
      transparent: true,
      uniforms: {
        uTime: { value: 0.0 },
        uResolution: { value: new THREE.Vector2(rect.width, rect.height) },
        uTextMask: { value: maskTexture }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec2 uResolution;
        uniform sampler2D uTextMask;
        varying vec2 vUv;
        
        // Simple 2D noise for organic movement
        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }
        
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          f = f * f * (3.0 - 2.0 * f);
          
          float a = hash(i);
          float b = hash(i + vec2(1.0, 0.0));
          float c = hash(i + vec2(0.0, 1.0));
          float d = hash(i + vec2(1.0, 1.0));
          
          return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }
        
        // FBM for organic waves
        float fbm(vec2 p) {
          float value = 0.0;
          float amplitude = 0.5;
          float frequency = 1.0;
          
          for (int i = 0; i < 4; i++) {
            value += amplitude * noise(p * frequency);
            frequency *= 2.0;
            amplitude *= 0.5;
          }
          
          return value;
        }
        
        void main() {
          vec2 uv = vUv;
          
          // Sample text mask (blurred glow)
          float mask = texture2D(uTextMask, uv).r;
          
          // Very soft falloff outside text area
          mask = smoothstep(0.0, 0.3, mask);
          
          if (mask < 0.01) {
            gl_FragColor = vec4(0.0);
            return;
          }
          
          // Slow drifting wave (8-20s period)
          float time = uTime * 0.08; // Very slow
          vec2 pos = uv * 3.0;
          
          // Layer 1: Cyan/blue drift
          vec2 drift1 = vec2(time * 0.3, time * 0.2);
          float wave1 = fbm(pos + drift1);
          
          // Layer 2: Magenta/amber drift (offset direction)
          vec2 drift2 = vec2(-time * 0.25, time * 0.35);
          float wave2 = fbm(pos + drift2 + vec2(1.5, 0.8));
          
          // Layer 3: Violet/soft amber (subtle)
          vec2 drift3 = vec2(time * 0.15, -time * 0.2);
          float wave3 = fbm(pos + drift3 + vec2(0.3, 2.1));
          
          // Mix prismatic colors - quiet, delicate
          vec3 color = vec3(0.0);
          color += vec3(0.4, 0.8, 1.0) * wave1 * 0.4;     // Cyan
          color += vec3(1.0, 0.4, 0.8) * wave2 * 0.35;    // Magenta
          color += vec3(1.0, 0.7, 0.5) * wave3 * 0.25;    // Soft amber
          color += vec3(0.6, 0.5, 0.9) * (wave1 * wave2) * 0.2; // Violet hint
          
          // Blend toward warm paper #FAFAF8
          vec3 paper = vec3(0.98, 0.98, 0.973);
          color = mix(paper, color, 0.35);
          
          // Very low opacity - delicate aurora
          float alpha = mask * 0.15;
          
          gl_FragColor = vec4(color, alpha);
        }
      `
    });

    const geometry = new THREE.PlaneGeometry(2, 2);
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    // Animation state
    let animationFrame: number | null = null;
    let isDisposed = false;
    let startTime = Date.now();

    // Continuous slow drift (not twitch)
    function render() {
      if (isDisposed) return;
      
      const elapsed = (Date.now() - startTime) * 0.001; // seconds
      material.uniforms.uTime.value = elapsed;
      
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(render);
    }

    // Handle window resize
    let resizeTimeout: ReturnType<typeof setTimeout>;
    
    async function handleResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(async () => {
        // Dispose on small viewports
        if (window.innerWidth <= 768 && !isDisposed) {
          cleanup();
          return;
        }
        
        if (isDisposed) return;
        
        // Recreate mask with new size
        const newTextMask = captureTextMask();
        maskTexture.image = newTextMask;
        maskTexture.needsUpdate = true;
        
        const newRect = headline.getBoundingClientRect();
        renderer.setSize(newRect.width, newRect.height);
        material.uniforms.uResolution.value.set(newRect.width, newRect.height);
      }, 250);
    }

    function cleanup() {
      isDisposed = true;
      if (animationFrame) cancelAnimationFrame(animationFrame);
      
      // Force WebGL context loss
      const gl = renderer.getContext();
      if (gl && gl.getExtension('WEBGL_lose_context')) {
        gl.getExtension('WEBGL_lose_context')!.loseContext();
      }
      
      renderer.dispose();
      geometry.dispose();
      material.dispose();
      maskTexture.dispose();
    }

    // Handle tab visibility
    function handleVisibilityChange() {
      if (document.hidden && animationFrame) {
        // Pause animation when tab hidden
        cancelAnimationFrame(animationFrame);
        animationFrame = null;
      } else if (!document.hidden && !animationFrame && !isDisposed) {
        // Resume animation when tab visible
        render();
      }
    }

    window.addEventListener('resize', handleResize);
    window.addEventListener('visibilitychange', handleVisibilityChange);

    // Start continuous drift
    render();

    return cleanup;
  }

  // Initialize when page loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuroraEffect);
  } else {
    initAuroraEffect();
  }
</script>
