---
// Shared WebGL background - scroll-scrubbed, one surface for entire page
// Atlas Motion craft: DOM type on top, GPU field behind
---

<canvas class="shared-webgl" aria-hidden="true"></canvas>

<style>
  .shared-webgl {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 1;
  }

  @media (max-width: 768px) {
    .shared-webgl {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shared-webgl {
      display: none;
    }
  }
</style>

<script>
  async function initSharedWebGL() {
    if (window.innerWidth <= 768) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const canvas = document.querySelector('.shared-webgl') as HTMLCanvasElement;
    if (!canvas) return;

    const THREE = await import('three');

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const renderer = new THREE.WebGLRenderer({ 
      canvas, 
      alpha: true,
      antialias: false,
      powerPreference: 'low-power'
    });

    function updateSize() {
      const width = window.innerWidth;
      const height = window.innerHeight;
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      return { width, height };
    }

    const size = updateSize();

    // Scroll-scrubbed shared background
    const material = new THREE.ShaderMaterial({
      transparent: true,
      uniforms: {
        uTime: { value: 0.0 },
        uScroll: { value: 0.0 },
        uResolution: { value: new THREE.Vector2(size.width, size.height) }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform float uScroll;
        uniform vec2 uResolution;
        varying vec2 vUv;
        
        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }
        
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          f = f * f * (3.0 - 2.0 * f);
          
          float a = hash(i);
          float b = hash(i + vec2(1.0, 0.0));
          float c = hash(i + vec2(0.0, 1.0));
          float d = hash(i + vec2(1.0, 1.0));
          
          return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }
        
        void main() {
          vec2 uv = vUv;
          
          // Scroll-scrubbed movement (Atlas craft)
          float time = uTime * 0.01;
          float scrollFactor = uScroll * 0.0008;
          
          // Subtle gradient shifts with scroll
          float gradient = uv.y * 0.4 + 0.6 + scrollFactor * 0.5;
          
          // Minimal paper texture
          vec2 noisePos = uv * 5.0 + vec2(time * 0.06 + scrollFactor, time * 0.04);
          float paperNoise = noise(noisePos) * 0.01;
          
          // Very slow drift
          float drift = sin(uv.x * 1.2 + time * 0.2 + scrollFactor * 0.3) * 0.005;
          
          float field = gradient + paperNoise + drift;
          
          // Warm paper base #FAFAF8
          vec3 paper = vec3(0.98, 0.98, 0.973);
          
          // Very subtle warm tint
          vec3 tint = mix(
            paper,
            vec3(0.992, 0.978, 0.972),
            field * 0.08
          );
          
          // Extremely low opacity - barely perceptible depth
          float alpha = 0.05;
          
          gl_FragColor = vec4(tint, alpha);
        }
      `
    });

    const geometry = new THREE.PlaneGeometry(2, 2);
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    let animationFrame: number | null = null;
    let isDisposed = false;
    let startTime = Date.now();
    let scrollY = 0;

    // Track scroll position
    function updateScroll() {
      scrollY = window.scrollY || window.pageYOffset;
    }

    function render() {
      if (isDisposed) return;
      
      const elapsed = (Date.now() - startTime) * 0.001;
      material.uniforms.uTime.value = elapsed;
      material.uniforms.uScroll.value = scrollY;
      
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(render);
    }

    let resizeTimeout: ReturnType<typeof setTimeout>;
    
    function handleResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (window.innerWidth <= 768 && !isDisposed) {
          cleanup();
          return;
        }
        
        if (isDisposed) return;
        
        const newSize = updateSize();
        material.uniforms.uResolution.value.set(newSize.width, newSize.height);
      }, 250);
    }

    function cleanup() {
      isDisposed = true;
      if (animationFrame) cancelAnimationFrame(animationFrame);
      
      window.removeEventListener('scroll', updateScroll);
      window.removeEventListener('resize', handleResize);
      window.removeEventListener('visibilitychange', handleVisibilityChange);
      
      const gl = renderer.getContext();
      if (gl && gl.getExtension('WEBGL_lose_context')) {
        gl.getExtension('WEBGL_lose_context')!.loseContext();
      }
      
      renderer.dispose();
      geometry.dispose();
      material.dispose();
    }

    function handleVisibilityChange() {
      if (document.hidden && animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = null;
      } else if (!document.hidden && !animationFrame && !isDisposed) {
        render();
      }
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', handleResize);
    window.addEventListener('visibilitychange', handleVisibilityChange);

    updateScroll();
    render();

    return cleanup;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSharedWebGL);
  } else {
    initSharedWebGL();
  }
</script>
