---
// Crystal-filled middle word - selective WebGL (not full-page wash)
// Photoreal crystal/caustic/prismatic glass material inside type only
const { word } = Astro.props;
---

<div class="crystal-word-container">
  <canvas class="crystal-canvas" aria-hidden="true"></canvas>
  <h1 class="crystal-word">{word}</h1>
</div>

<style>
  .crystal-word-container {
    position: relative;
    width: fit-content;
    margin: 0 auto;
  }

  .crystal-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: normal;
    opacity: 0.95;
  }

  .crystal-word {
    position: relative;
    z-index: 1;
    font-family: 'Anton', 'Impact', sans-serif;
    font-size: clamp(96px, 22vw, 380px);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: 0.02em;
    margin: 0;
    text-transform: uppercase;
    /* BOLD crystal - high contrast prismatic glass (NOT pastel) */
    background: 
      conic-gradient(from 45deg at 30% 40%,
        #FF0080 0deg,
        #FF00FF 60deg,
        #0080FF 120deg,
        #00FFFF 180deg,
        #00FF80 240deg,
        #FFFF00 300deg,
        #FF0080 360deg
      ),
      conic-gradient(from 135deg at 70% 60%,
        #0080FF 0deg,
        #FF00FF 90deg,
        #FF8000 180deg,
        #00FFFF 270deg,
        #0080FF 360deg
      ),
      linear-gradient(180deg,
        rgba(255, 255, 255, 1) 0%,
        rgba(200, 230, 255, 0.95) 25%,
        rgba(255, 200, 230, 0.95) 50%,
        rgba(230, 255, 200, 0.95) 75%,
        rgba(255, 255, 255, 1) 100%
      );
    background-size: 800px 800px, 600px 600px, 100% 100%;
    background-position: 10% 20%, 80% 70%, center;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: crystalRotate 30s linear infinite;
  }

  @keyframes crystalRotate {
    0% { 
      background-position: 10% 20%, 80% 70%, center;
    }
    100% { 
      background-position: 110% 120%, 180% 170%, center;
    }
  }

  @media (max-width: 768px) {
    .crystal-canvas {
      display: none;
    }
    
    .crystal-word {
      /* Static BOLD crystal on mobile */
      background: 
        conic-gradient(from 60deg at 35% 45%,
          #FF0080 0deg,
          #FF00FF 90deg,
          #0080FF 180deg,
          #00FFFF 270deg,
          #FF0080 360deg
        ),
        linear-gradient(160deg,
          rgba(255, 255, 255, 1) 0%,
          rgba(180, 220, 255, 0.9) 50%,
          rgba(255, 255, 255, 1) 100%
        );
      background-size: 500px 500px, 100% 100%;
      background-position: 30% 40%, center;
      background-clip: text;
      -webkit-background-clip: text;
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crystal-canvas {
      display: none;
    }
    
    .crystal-word {
      background: 
        conic-gradient(from 45deg at 40% 50%,
          #FF0080 0deg,
          #8000FF 72deg,
          #0080FF 144deg,
          #00FF80 216deg,
          #FF8000 288deg,
          #FF0080 360deg
        ),
        linear-gradient(145deg,
          rgba(255, 255, 255, 1) 0%,
          rgba(200, 230, 255, 0.95) 50%,
          rgba(255, 255, 255, 1) 100%
        );
      background-size: 600px 600px, 100% 100%;
      background-position: 40% 50%, center;
      background-clip: text;
      -webkit-background-clip: text;
      animation: none;
    }
  }
</style>

<script>
  async function initCrystalEffect() {
    if (window.innerWidth <= 768) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const container = document.querySelector('.crystal-word-container') as HTMLElement;
    const canvas = document.querySelector('.crystal-canvas') as HTMLCanvasElement;
    const word = document.querySelector('.crystal-word') as HTMLElement;
    
    if (!container || !canvas || !word) return;

    const THREE = await import('three');

    await document.fonts.ready;

    function updateCanvasSize() {
      const rect = word.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio, 2);
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;
      return { width: rect.width, height: rect.height };
    }

    const size = updateCanvasSize();

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const renderer = new THREE.WebGLRenderer({ 
      canvas, 
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });

    renderer.setSize(size.width, size.height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Simplified crystal shader - high compatibility
    const material = new THREE.ShaderMaterial({
      transparent: true,
      uniforms: {
        uTime: { value: 0.0 },
        uResolution: { value: new THREE.Vector2(size.width, size.height) }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        precision mediump float;
        uniform float uTime;
        uniform vec2 uResolution;
        varying vec2 vUv;
        
        // Simple hash for pseudo-random
        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }
        
        // Simple noise
        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          f = f * f * (3.0 - 2.0 * f);
          
          float a = hash(i);
          float b = hash(i + vec2(1.0, 0.0));
          float c = hash(i + vec2(0.0, 1.0));
          float d = hash(i + vec2(1.0, 1.0));
          
          return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }
        
        // FBM for crystal texture
        float fbm(vec2 p) {
          float value = 0.0;
          float amplitude = 0.5;
          for(int i = 0; i < 4; i++) {
            value += amplitude * noise(p);
            p *= 2.0;
            amplitude *= 0.5;
          }
          return value;
        }
        
        void main() {
          vec2 uv = vUv;
          float time = uTime * 0.05;
          
          // Rotating crystal facets
          float angle = time + uv.x * 2.0;
          vec2 p1 = vec2(
            uv.x * cos(angle) - uv.y * sin(angle),
            uv.x * sin(angle) + uv.y * cos(angle)
          ) * 3.0;
          
          vec2 p2 = uv * 4.0 + vec2(time * 0.3, -time * 0.2);
          
          // Layered noise for depth
          float n1 = fbm(p1);
          float n2 = fbm(p2);
          float pattern = (n1 + n2) * 0.5;
          
          // VIVID prismatic colors - full saturation
          float hue = fract(pattern + time * 0.1);
          vec3 color;
          
          // Pure saturated spectrum
          if (hue < 0.14) {
            color = vec3(1.0, 0.0, 0.4); // Hot pink
          } else if (hue < 0.28) {
            color = vec3(1.0, 0.0, 1.0); // Magenta
          } else if (hue < 0.42) {
            color = vec3(0.4, 0.0, 1.0); // Deep blue
          } else if (hue < 0.57) {
            color = vec3(0.0, 0.6, 1.0); // Cyan
          } else if (hue < 0.71) {
            color = vec3(0.0, 1.0, 0.6); // Aqua
          } else if (hue < 0.85) {
            color = vec3(1.0, 0.8, 0.0); // Gold
          } else {
            color = vec3(1.0, 0.4, 0.0); // Orange
          }
          
          // Add crystal sparkle without washing out
          float sparkle = smoothstep(0.75, 0.98, pattern);
          color = color + color * sparkle * 0.4; // Brighten, don't wash
          
          // PURE VIVID COLORS - NO gray/white washing
          // Remove any desaturation completely
          
          float alpha = 0.98;
          
          gl_FragColor = vec4(color, alpha);
        }
      `
    });

    const geometry = new THREE.PlaneGeometry(2, 2);
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    let animationFrame: number | null = null;
    let isDisposed = false;
    let startTime = Date.now();

    function render() {
      if (isDisposed) return;
      
      const elapsed = (Date.now() - startTime) * 0.001;
      material.uniforms.uTime.value = elapsed;
      
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(render);
    }

    let resizeTimeout: ReturnType<typeof setTimeout>;
    
    function handleResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (window.innerWidth <= 768 && !isDisposed) {
          cleanup();
          return;
        }
        
        if (isDisposed) return;
        
        const newSize = updateCanvasSize();
        renderer.setSize(newSize.width, newSize.height);
        material.uniforms.uResolution.value.set(newSize.width, newSize.height);
      }, 250);
    }

    function cleanup() {
      isDisposed = true;
      if (animationFrame) cancelAnimationFrame(animationFrame);
      
      window.removeEventListener('resize', handleResize);
      window.removeEventListener('visibilitychange', handleVisibilityChange);
      
      const gl = renderer.getContext();
      if (gl && gl.getExtension('WEBGL_lose_context')) {
        gl.getExtension('WEBGL_lose_context')!.loseContext();
      }
      
      renderer.dispose();
      geometry.dispose();
      material.dispose();
    }

    function handleVisibilityChange() {
      if (document.hidden && animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = null;
      } else if (!document.hidden && !animationFrame && !isDisposed) {
        render();
      }
    }

    window.addEventListener('resize', handleResize);
    window.addEventListener('visibilitychange', handleVisibilityChange);

    render();

    return cleanup;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCrystalEffect);
  } else {
    initCrystalEffect();
  }
</script>
