---
// Crystal-filled middle word - selective WebGL (not full-page wash)
// Photoreal crystal/caustic/prismatic glass material inside type only
const { word } = Astro.props;
---

<div class="crystal-word-container">
  <canvas class="crystal-canvas" aria-hidden="true"></canvas>
  <h1 class="crystal-word">{word}</h1>
</div>

<style>
  .crystal-word-container {
    position: relative;
    width: fit-content;
    margin: 0 auto;
  }

  .crystal-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: multiply;
  }

  .crystal-word {
    position: relative;
    z-index: 1;
    font-family: 'Anton', 'Impact', sans-serif;
    font-size: clamp(96px, 22vw, 380px);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: 0.02em;
    margin: 0;
    text-transform: uppercase;
    /* Photoreal crystal - faceted glass with prismatic dispersion */
    background: 
      radial-gradient(ellipse at 20% 30%, rgba(255, 100, 200, 0.9) 0%, transparent 50%),
      radial-gradient(ellipse at 60% 70%, rgba(100, 200, 255, 0.9) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(255, 255, 100, 0.9) 0%, transparent 50%),
      radial-gradient(ellipse at 40% 80%, rgba(100, 255, 200, 0.9) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 50%, rgba(200, 100, 255, 0.9) 0%, transparent 50%),
      linear-gradient(135deg, 
        rgba(255, 255, 255, 0.9) 0%,
        rgba(220, 240, 255, 0.8) 20%,
        rgba(255, 220, 240, 0.8) 40%,
        rgba(240, 255, 220, 0.8) 60%,
        rgba(220, 240, 255, 0.8) 80%,
        rgba(255, 255, 255, 0.9) 100%
      );
    background-size: 600px 600px, 500px 500px, 550px 550px, 520px 520px, 580px 580px, 100% 100%;
    background-position: 0% 0%, 40% 40%, 80% 20%, 20% 80%, 60% 60%, center;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: crystalShift 25s linear infinite;
  }

  @keyframes crystalShift {
    0% { 
      background-position: 0% 0%, 40% 40%, 80% 20%, 20% 80%, 60% 60%, center;
    }
    100% { 
      background-position: 100% 100%, 140% 140%, 180% 120%, 120% 180%, 160% 160%, center;
    }
  }

  @media (max-width: 768px) {
    .crystal-canvas {
      display: none;
    }
    
    .crystal-word {
      /* Static photoreal crystal on mobile */
      background: 
        radial-gradient(ellipse at 20% 30%, rgba(255, 100, 200, 0.9) 0%, transparent 50%),
        radial-gradient(ellipse at 60% 70%, rgba(100, 200, 255, 0.9) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 20%, rgba(255, 255, 100, 0.9) 0%, transparent 50%),
        linear-gradient(135deg, 
          rgba(255, 255, 255, 0.9) 0%,
          rgba(220, 240, 255, 0.8) 50%,
          rgba(255, 255, 255, 0.9) 100%
        );
      background-size: 400px 400px, 350px 350px, 380px 380px, 100% 100%;
      background-position: 0% 0%, 40% 40%, 80% 20%, center;
      background-clip: text;
      -webkit-background-clip: text;
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crystal-canvas {
      display: none;
    }
    
    .crystal-word {
      background: 
        radial-gradient(ellipse at 30% 40%, rgba(255, 100, 200, 0.8) 0%, transparent 50%),
        radial-gradient(ellipse at 70% 60%, rgba(100, 200, 255, 0.8) 0%, transparent 50%),
        linear-gradient(135deg, 
          rgba(255, 255, 255, 0.9) 0%,
          rgba(230, 240, 255, 0.8) 50%,
          rgba(255, 255, 255, 0.9) 100%
        );
      background-size: 500px 500px, 450px 450px, 100% 100%;
      background-position: 20% 30%, 70% 60%, center;
      background-clip: text;
      -webkit-background-clip: text;
      animation: none;
    }
  }
</style>

<script>
  async function initCrystalEffect() {
    if (window.innerWidth <= 768) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const container = document.querySelector('.crystal-word-container') as HTMLElement;
    const canvas = document.querySelector('.crystal-canvas') as HTMLCanvasElement;
    const word = document.querySelector('.crystal-word') as HTMLElement;
    
    if (!container || !canvas || !word) return;

    const THREE = await import('three');

    await document.fonts.ready;

    function updateCanvasSize() {
      const rect = word.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio, 2);
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;
      return { width: rect.width, height: rect.height };
    }

    const size = updateCanvasSize();

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const renderer = new THREE.WebGLRenderer({ 
      canvas, 
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });

    renderer.setSize(size.width, size.height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Photoreal crystal shader - faceted glass caustics
    const material = new THREE.ShaderMaterial({
      transparent: true,
      uniforms: {
        uTime: { value: 0.0 },
        uResolution: { value: new THREE.Vector2(size.width, size.height) }
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec2 uResolution;
        varying vec2 vUv;
        
        // Photoreal crystal facets - sharp prismatic dispersion
        vec3 hash3(vec2 p) {
          vec3 q = vec3(
            dot(p, vec2(127.1, 311.7)), 
            dot(p, vec2(269.5, 183.3)),
            dot(p, vec2(419.2, 371.9))
          );
          return fract(sin(q) * 43758.5453);
        }
        
        // Voronoi for faceted look
        float voronoi(vec2 p, out vec2 cellId) {
          vec2 n = floor(p);
          vec2 f = fract(p);
          
          float minDist = 8.0;
          vec2 minPoint;
          
          for (int j = -1; j <= 1; j++) {
            for (int i = -1; i <= 1; i++) {
              vec2 g = vec2(float(i), float(j));
              vec3 o = hash3(n + g);
              vec2 r = g - f + o.xy;
              float d = dot(r, r);
              if (d < minDist) {
                minDist = d;
                minPoint = n + g;
              }
            }
          }
          cellId = minPoint;
          return sqrt(minDist);
        }
        
        void main() {
          vec2 uv = vUv;
          float time = uTime * 0.06;
          
          // Large facets for crystal structure
          vec2 cellId1;
          float v1 = voronoi(uv * 4.0 + vec2(time * 0.15, time * 0.1), cellId1);
          
          vec2 cellId2;
          float v2 = voronoi(uv * 6.0 + vec2(-time * 0.12, time * 0.18), cellId2);
          
          // Create sharp facet edges
          float facet = smoothstep(0.05, 0.15, v1) * smoothstep(0.03, 0.1, v2);
          facet = pow(facet, 0.8);
          
          // Prismatic dispersion per facet
          vec3 facetColor1 = hash3(cellId1);
          vec3 facetColor2 = hash3(cellId2);
          
          // Map to realistic crystal colors (clear with prismatic highlights)
          vec3 base = vec3(0.95, 0.96, 0.98); // Clear crystal base
          
          // Add prismatic highlights
          vec3 prism1 = vec3(
            facetColor1.r * 0.8 + 0.2,
            facetColor1.g * 0.6 + 0.4,
            facetColor1.b * 0.9 + 0.1
          );
          
          vec3 prism2 = vec3(
            facetColor2.r * 0.6 + 0.4,
            facetColor2.g * 0.8 + 0.2,
            facetColor2.b * 0.7 + 0.3
          );
          
          // Mix colors based on facet structure
          vec3 color = mix(base, prism1, (1.0 - v1) * 0.6);
          color = mix(color, prism2, (1.0 - v2) * 0.5);
          
          // Add bright caustic highlights
          float caustic = smoothstep(0.02, 0.08, v1) * smoothstep(0.01, 0.06, v2);
          color += vec3(1.0) * caustic * 0.4;
          
          // Sharp alpha for faceted look
          float alpha = facet * 0.95;
          
          gl_FragColor = vec4(color, alpha);
        }
      `
    });

    const geometry = new THREE.PlaneGeometry(2, 2);
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    let animationFrame: number | null = null;
    let isDisposed = false;
    let startTime = Date.now();

    function render() {
      if (isDisposed) return;
      
      const elapsed = (Date.now() - startTime) * 0.001;
      material.uniforms.uTime.value = elapsed;
      
      renderer.render(scene, camera);
      animationFrame = requestAnimationFrame(render);
    }

    let resizeTimeout: ReturnType<typeof setTimeout>;
    
    function handleResize() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (window.innerWidth <= 768 && !isDisposed) {
          cleanup();
          return;
        }
        
        if (isDisposed) return;
        
        const newSize = updateCanvasSize();
        renderer.setSize(newSize.width, newSize.height);
        material.uniforms.uResolution.value.set(newSize.width, newSize.height);
      }, 250);
    }

    function cleanup() {
      isDisposed = true;
      if (animationFrame) cancelAnimationFrame(animationFrame);
      
      window.removeEventListener('resize', handleResize);
      window.removeEventListener('visibilitychange', handleVisibilityChange);
      
      const gl = renderer.getContext();
      if (gl && gl.getExtension('WEBGL_lose_context')) {
        gl.getExtension('WEBGL_lose_context')!.loseContext();
      }
      
      renderer.dispose();
      geometry.dispose();
      material.dispose();
    }

    function handleVisibilityChange() {
      if (document.hidden && animationFrame) {
        cancelAnimationFrame(animationFrame);
        animationFrame = null;
      } else if (!document.hidden && !animationFrame && !isDisposed) {
        render();
      }
    }

    window.addEventListener('resize', handleResize);
    window.addEventListener('visibilitychange', handleVisibilityChange);

    render();

    return cleanup;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCrystalEffect);
  } else {
    initCrystalEffect();
  }
</script>
