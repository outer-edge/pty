---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="PTY.AI — Proprietary systems you can stand behind">
  <section id="studio" class="hero-section">
    <h1 class="hero-headline">
      Proprietary systems you can stand behind.
    </h1>
    <p class="hero-subline">
      Design and run the loop. Auckland.
    </p>
  </section>
</BaseLayout>

<style>
  .hero-section {
    max-width: 960px;
    padding-top: 48px;
  }

  .hero-headline {
    font-family: var(--font-grotesk);
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 32px;
  }

  .hero-subline {
    font-family: var(--font-grotesk);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: var(--ink-mid);
    margin: 0;
  }

  @media (max-width: 968px) {
    .hero-section {
      padding-top: 32px;
    }
  }
</style>
