---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="PTY.AI — Proprietary systems you can stand behind">
  <!-- Beat 1: Hero Thesis -->
  <section id="hero" class="hero-section">
    <h1 class="hero-display">
      Proprietary systems you can stand&nbsp;behind.
    </h1>
  </section>

  <!-- Beat 2: Method - Numbered process -->
  <section id="method-beat" class="process-beat">
    <div class="process-number">
      <span class="process-label">— Our Process</span>
      <span class="process-num">01</span>
    </div>
    <div class="process-content">
      <h2 class="process-display">Method</h2>
      <p class="process-caption">
        We design AI systems for companies with stakes. From concept to deployment, 
        we run the loop—specification, architecture, training, evaluation, and production.
      </p>
      <a href="/method" class="process-link">
        <span class="link-text">Read Method</span>
        <span class="link-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <!-- Beat 3: Work - Numbered process -->
  <section id="work-beat" class="process-beat">
    <div class="process-number">
      <span class="process-label">— Selected Work</span>
      <span class="process-num">02</span>
    </div>
    <div class="process-content">
      <h2 class="process-display">Work</h2>
      <p class="process-caption">
        Proprietary models, inference infrastructure, and evaluation pipelines 
        across finance, logistics, and research.
      </p>
      <a href="/work" class="process-link">
        <span class="link-text">View Work</span>
        <span class="link-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <!-- Beat 4: POV/Thesis -->
  <section id="thesis-beat" class="thesis-section">
    <div class="thesis-content">
      <p class="thesis-display">
        Most companies need AI systems they can stand behind—systems that work, 
        systems they control, systems that don't disappear when the API changes.
      </p>
      <p class="thesis-caption">
        We build those systems. Auckland.
      </p>
    </div>
  </section>

  <!-- Beat 5: Close CTA -->
  <section id="close-cta" class="cta-section">
    <a href="/contact" class="cta-button">
      <span class="cta-text">Start a Brief</span>
      <span class="cta-tick" aria-hidden="true">✓</span>
    </a>
  </section>
</BaseLayout>

<style>
  /* Two type sizes only: huge display + tiny caption */
  
  /* Hero Beat */
  .hero-section {
    position: relative;
    z-index: 10;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 0 12%;
  }

  .hero-display {
    font-family: var(--font-grotesk);
    font-size: clamp(64px, 10vw, 140px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: 0;
    max-width: 1200px;
  }

  /* Process Beats - Numbered sections (Atlas craft) */
  .process-beat {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 80px;
    padding: clamp(120px, 18vh, 240px) 12%;
    border-top: 1px solid var(--hairline);
  }

  .process-number {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .process-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mid);
  }

  .process-num {
    font-family: var(--font-grotesk);
    font-size: 80px;
    font-weight: 400;
    line-height: 1;
    color: var(--hairline);
    letter-spacing: -0.02em;
  }

  .process-content {
    max-width: 720px;
  }

  .process-display {
    font-family: var(--font-grotesk);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 48px 0;
    text-transform: uppercase;
  }

  .process-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.8;
    letter-spacing: 0.02em;
    color: var(--ink-mid);
    margin: 0 0 40px 0;
    max-width: 560px;
  }

  .process-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    transition: all 0.6s var(--ease-out);
  }

  .process-link:hover {
    border-color: var(--vermilion);
    color: var(--vermilion);
    transform: translateY(-1px);
  }

  .link-arrow {
    transition: transform 0.6s var(--ease-out);
  }

  .process-link:hover .link-arrow {
    transform: translate(2px, -2px);
  }

  /* Thesis Beat */
  .thesis-section {
    position: relative;
    z-index: 10;
    padding: clamp(160px, 24vh, 320px) 12%;
    border-top: 1px solid var(--hairline);
    background: linear-gradient(180deg, transparent 0%, rgba(216, 28, 14, 0.01) 100%);
  }

  .thesis-content {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }

  .thesis-display {
    font-family: var(--font-grotesk);
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 32px 0;
  }

  .thesis-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mid);
    margin: 0;
  }

  /* Close CTA */
  .cta-section {
    position: relative;
    z-index: 10;
    padding: clamp(100px, 15vh, 200px) 12% clamp(140px, 20vh, 280px);
    text-align: center;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 20px 40px;
    background: var(--vermilion);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    transition: all 0.6s var(--ease-out);
  }

  .cta-button:hover {
    background: #c01808;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(216, 28, 14, 0.2);
  }

  .cta-tick {
    font-size: 14px;
    line-height: 1;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .hero-section,
    .process-beat,
    .thesis-section,
    .cta-section {
      padding-left: 8%;
      padding-right: 8%;
    }
  }

  @media (max-width: 768px) {
    .hero-section,
    .process-beat,
    .thesis-section,
    .cta-section {
      padding-left: 24px;
      padding-right: 24px;
    }

    .hero-section {
      min-height: 75vh;
    }

    .process-beat {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-top: 80px;
      padding-bottom: 80px;
    }

    .process-number {
      flex-direction: row;
      align-items: baseline;
      gap: 16px;
    }

    .process-num {
      font-size: 48px;
    }

    .thesis-section {
      padding-top: 100px;
      padding-bottom: 100px;
    }

    .cta-section {
      padding-top: 80px;
      padding-bottom: 100px;
    }
  }
</style>
