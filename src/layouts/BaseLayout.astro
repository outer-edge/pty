---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Design and run the loop. Auckland.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <!-- Top masthead -->
    <header class="top-masthead">
      <div class="masthead-content">
        <span class="masthead-title">PTY.AI</span>
        <span class="masthead-meta">v0.1</span>
        <span class="masthead-dot">·</span>
        <span class="masthead-meta">AKL</span>
        <span class="masthead-dot">·</span>
        <span class="masthead-meta">LIVE</span>
      </div>
      <a href="/contact" class="brief-pill">
        <span>Brief</span>
        <span class="brief-tick" aria-hidden="true">✓</span>
      </a>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="page-footer">
      <div class="footer-content">
        <div class="footer-col">
          <span class="footer-label">PTY.AI v0.1</span>
          <span class="footer-dot">·</span>
          <span class="footer-label">Auckland</span>
        </div>
        <div class="footer-col">
          <a href="/method" class="footer-link">Method</a>
          <a href="/work" class="footer-link">Work</a>
          <a href="/contact" class="footer-link">Brief</a>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --paper: #FAFAF8;
        --ink: #1a1a1a;
        --ink-mid: #666666;
        --vermilion: #D81C0E;
        --hairline: #C8C8C2;
        
        --font-grotesk: 'Space Grotesk', system-ui, -apple-system, sans-serif;
        --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
        
        /* Atlas craft: long damped easing */
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-grotesk);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        min-height: 100vh;
      }

      .skip-link {
        position: fixed;
        top: -100px;
        left: 0;
        background: var(--vermilion);
        color: white;
        padding: 8px 16px;
        text-decoration: none;
        font-family: var(--font-mono);
        font-size: 12px;
        z-index: 100;
      }

      .skip-link:focus {
        top: 0;
      }

      /* Top masthead - PTY.AI v0.1 · AKL · LIVE */
      .top-masthead {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 64px;
        background: var(--paper);
        border-bottom: 1px solid var(--hairline);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 8%;
        z-index: 100;
      }

      .masthead-content {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .masthead-title {
        font-weight: 500;
        color: var(--ink);
      }

      .masthead-meta {
        color: var(--ink-mid);
      }

      .masthead-dot {
        color: var(--hairline);
      }

      /* Brief pill */
      .brief-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: transparent;
        border: 1px solid var(--hairline);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--ink);
        transition: all 0.6s var(--ease-out);
      }

      .brief-pill:hover {
        border-color: var(--vermilion);
        background: var(--vermilion);
        color: var(--paper);
      }

      .brief-tick {
        color: var(--vermilion);
        font-size: 12px;
        line-height: 1;
        transition: color 0.6s var(--ease-out);
      }

      .brief-pill:hover .brief-tick {
        color: var(--paper);
      }

      /* Main content */
      main {
        margin-top: 64px;
      }

      /* Footer */
      .page-footer {
        border-top: 1px solid var(--hairline);
        padding: 40px 12%;
      }

      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .footer-col {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .footer-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-mid);
      }

      .footer-dot {
        color: var(--hairline);
      }

      .footer-link {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--ink-mid);
        transition: color 0.6s var(--ease-out);
      }

      .footer-link:hover {
        color: var(--vermilion);
      }

      /* Responsive */
      @media (max-width: 1200px) {
        .top-nav {
          padding: 0 8%;
        }

        .page-footer {
          padding: 40px 8%;
        }
      }

      @media (max-width: 768px) {
        .top-nav {
          padding: 0 24px;
        }

        .page-footer {
          padding: 40px 24px;
        }

        .footer-content {
          flex-direction: column;
          gap: 24px;
          align-items: flex-start;
        }

        .footer-col {
          flex-wrap: wrap;
        }
      }
    </style>
  </body>
</html>
