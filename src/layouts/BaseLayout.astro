---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Design and run the loop. Auckland.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <header class="masthead">
      <div class="masthead-left">TX-01 / ENGAGEMENT</div>
      <div class="masthead-center">
        <span class="masthead-title">PTY.AI</span>
        <span class="masthead-meta">v0.1</span>
        <span class="masthead-dot">·</span>
        <span class="masthead-meta">AKL</span>
        <span class="masthead-dot">·</span>
        <span class="masthead-meta">LIVE</span>
      </div>
      <div class="masthead-right">
        <a href="/contact" class="contact-link">
          <span class="contact-tick" aria-hidden="true">✓</span>
          CONTACT
        </a>
      </div>
    </header>

    <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="menu-icon"></span>
      <span class="menu-icon"></span>
      <span class="menu-icon"></span>
    </button>

    <nav class="chapter-rail" role="navigation" aria-label="Main navigation">
      <ul>
        <li>
          <a href="/#studio" class:list={["chapter-link", { active: currentPath === '/' }]}>
            <span class="chapter-num">01</span>
            <span class="chapter-name">Studio</span>
          </a>
        </li>
        <li>
          <a href="/method" class:list={["chapter-link", { active: currentPath === '/method' }]}>
            <span class="chapter-num">02</span>
            <span class="chapter-name">Method</span>
          </a>
        </li>
        <li>
          <a href="/work" class:list={["chapter-link", { active: currentPath === '/work' }]}>
            <span class="chapter-num">03</span>
            <span class="chapter-name">Work</span>
          </a>
        </li>
        <li>
          <a href="/contact" class:list={["chapter-link", { active: currentPath === '/contact' }]}>
            <span class="chapter-num">04</span>
            <span class="chapter-name">Brief</span>
          </a>
        </li>
      </ul>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer class="page-footer">
      <span>PAPER</span>
      <span class="footer-dot">·</span>
      <span>MONO</span>
      <span class="footer-dot">·</span>
      <span>NO CRT</span>
    </footer>

    <style is:global>
      :root {
        --paper: #FAFAF8;
        --vermilion: #D81C0E;
        --hairline: #C8C8C2;
        --ink: #1A1A1A;
        --ink-mid: #606060;
        
        --font-grotesk: 'Work Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-grotesk);
        background: var(--paper);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 212px 1fr;
        grid-template-rows: auto 1fr auto;
        gap: 0;
      }

      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--vermilion);
        color: white;
        padding: 8px 16px;
        text-decoration: none;
        font-family: var(--font-mono);
        font-size: 12px;
        z-index: 100;
      }

      .skip-link:focus {
        top: 0;
      }

      .masthead {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 212px 1fr auto;
        align-items: center;
        height: 64px;
        border-bottom: 1px solid var(--hairline);
        padding: 0 32px 0 0;
      }

      .masthead-left {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: var(--ink-mid);
        padding-left: 32px;
        border-right: 1px solid var(--hairline);
        height: 100%;
        display: flex;
        align-items: center;
      }

      .masthead-center {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        padding-left: 32px;
        display: flex;
        gap: 8px;
        align-items: center;
      }

      .masthead-title {
        font-weight: 500;
        color: var(--ink);
      }

      .masthead-meta {
        color: var(--ink-mid);
      }

      .masthead-dot {
        color: var(--hairline);
      }

      .masthead-right {
        display: flex;
        align-items: center;
      }

      .contact-link {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border: 1px solid var(--hairline);
        transition: border-color 0.2s ease;
      }

      .contact-link:hover {
        border-color: var(--vermilion);
      }

      .contact-tick {
        color: var(--vermilion);
        font-size: 14px;
        line-height: 1;
      }

      .menu-toggle {
        display: none;
        position: fixed;
        top: 16px;
        left: 16px;
        z-index: 1000;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 8px;
        flex-direction: column;
        gap: 4px;
      }

      .menu-icon {
        display: block;
        width: 20px;
        height: 2px;
        background: var(--ink);
        transition: all 0.3s ease;
      }

      .chapter-rail {
        grid-column: 1;
        grid-row: 2;
        border-right: 1px solid var(--hairline);
        padding: 48px 0;
      }

      .chapter-rail ul {
        list-style: none;
      }

      .chapter-rail li {
        border-bottom: 1px solid var(--hairline);
      }

      .chapter-link {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 32px;
        text-decoration: none;
        color: var(--ink);
        transition: background 0.2s ease;
      }

      .chapter-link:hover {
        background: rgba(216, 28, 14, 0.03);
      }

      .chapter-link.active {
        background: rgba(216, 28, 14, 0.05);
      }

      .chapter-num {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.02em;
        color: var(--ink-mid);
        white-space: nowrap;
      }

      .chapter-name {
        font-family: var(--font-grotesk);
        font-size: 18px;
        font-weight: 400;
        white-space: nowrap;
      }

      main {
        grid-column: 2;
        grid-row: 2;
        padding: 64px;
        min-height: calc(100vh - 64px - 56px);
      }

      .page-footer {
        grid-column: 1 / -1;
        border-top: 1px solid var(--hairline);
        padding: 20px 32px;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ink-mid);
        display: flex;
        gap: 8px;
        align-items: center;
      }

      .footer-dot {
        color: var(--hairline);
      }

      @media (max-width: 968px) {
        body {
          grid-template-columns: 1fr;
        }

        .menu-toggle {
          display: flex;
        }

        .masthead {
          grid-template-columns: 1fr auto;
          padding: 0 16px;
        }

        .masthead-left {
          display: none;
        }

        .masthead-center {
          padding-left: 56px;
        }

        .chapter-rail {
          position: fixed;
          top: 0;
          left: 0;
          width: 280px;
          height: 100vh;
          background: var(--paper);
          border-right: 1px solid var(--hairline);
          z-index: 999;
          transform: translateX(-100%);
          transition: transform 0.3s ease;
          overflow-y: auto;
        }

        .chapter-rail[data-open="true"] {
          transform: translateX(0);
        }

        main {
          grid-column: 1;
          padding: 32px 24px;
        }

        .page-footer {
          justify-content: center;
        }
      }

      @media (max-width: 390px) {
        main {
          padding: 24px 16px;
        }

        .masthead-center {
          font-size: 10px;
          gap: 6px;
        }

        .contact-link {
          font-size: 10px;
          padding: 6px 12px;
        }
      }
    </style>

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const chapterRail = document.querySelector('.chapter-rail');
      
      if (menuToggle && chapterRail) {
        menuToggle.addEventListener('click', () => {
          const isOpen = chapterRail.getAttribute('data-open') === 'true';
          chapterRail.setAttribute('data-open', (!isOpen).toString());
          menuToggle.setAttribute('aria-expanded', (!isOpen).toString());
        });

        chapterRail.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) {
            chapterRail.setAttribute('data-open', 'false');
            menuToggle?.setAttribute('aria-expanded', 'false');
          }
        });
      }
    </script>
  </body>
</html>
